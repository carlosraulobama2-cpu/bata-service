# ---- Agent API (development) ----
NODE_ENV=development
PORT=3000

# Agent service database (schema "agent")
DATABASE_URL=postgresql://postgres@localhost:5432/bata_services
# Ledger. In development the ledger schema lives in the same PostgreSQL and is
# called directly (LEDGER_MODE=local). In production the Ledger is a separate
# service reached over its internal API.
LEDGER_MODE=local
LEDGER_DATABASE_URL=postgresql://postgres@localhost:5432/bata_services

# BataPay Core. "fake" = in-memory simulator for development and tests.
CORE_MODE=fake
# Shared secret used by BataPay Core to sign events sent to /internal/v1/core-events
CORE_EVENTS_HMAC_SECRET=dev-only-change-me-dev-only-change-me

# Tokens: ES256 key pair. Generate with: pnpm keys:dev
JWT_PRIVATE_KEY_PEM=
JWT_ISSUER=bata-services-dev
JWT_AUDIENCE=bata-services-agent
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=7

# Secrets for PIN pepper and lookup HMAC. In production these come from KMS/HSM.
PIN_PEPPER=dev-only-pepper-change-me-dev-only-pepper
LOOKUP_HMAC_KEY=dev-only-lookup-key-change-me-dev-only

PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
NEW_DEVICE_COOLDOWN_HOURS=24
NEW_DEVICE_LIMIT_FACTOR_BPS=2500
MAX_TRUSTED_DEVICES=1
SIGNATURE_MAX_SKEW_SECONDS=60
CASH_IN_CONFIRMATION_TTL_SECONDS=180

# QR codes issued by the agent (cobro, QR estático): Ed25519 key. Generate with: pnpm keys:dev
QR_SIGNING_PRIVATE_KEY_PEM=
QR_COLLECT_TTL_SECONDS=300

DEFAULT_CURRENCY=XAF
OPERATING_TIMEZONE=Africa/Malabo
MIN_APP_VERSION=1.0.0

# Push notifications: "expo" sends through the Expo push service (FCM/APNs
# credentials are configured in EAS); "memory" sends nothing (development).
PUSH_MODE=memory
EXPO_ACCESS_TOKEN=

# Redis for rate limits (required in production, shared by every replica).
# Empty = in-process counters, fine for a single local process.
REDIS_URL=
RATE_LIMITS_ENABLED=true

# Browser origins allowed to call the API (e.g. the Expo web preview). Empty in production.
CORS_ORIGINS=

# Dev seed
SEED_AGENT_PHONE=+240222000001
SEED_AGENT_PIN=482913
