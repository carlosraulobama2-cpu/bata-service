{
  "name": "@bata/agent-api",
  "version": "0.1.0",
  "private": true,
  "description": "BATA SERVICES \u2014 Agent Backend (Agent API)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "ts-node --transpile-only src/main.ts",
    "db:migrate": "ts-node --transpile-only scripts/migrate.ts",
    "db:seed": "ts-node --transpile-only scripts/seed-dev.ts",
    "keys:dev": "ts-node --transpile-only scripts/generate-dev-keys.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@bata/money": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "argon2": "^0.45.1",
    "fastify": "5.11.3",
    "kysely": "^0.28.17",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bata/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/test/support/global-setup.ts",
    "moduleNameMapper": {
      "^@bata/money$": "<rootDir>/../../packages/money/src"
    }
  }
}
