{
  "expo": {
    "name": "VELYNT SERVICES",
    "slug": "velynt-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.velynt.services",
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se usa solo para escanear códigos QR de clientes.",
        "NSFaceIDUsageDescription": "Usamos Face ID para confirmar tus operaciones."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2A66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.velynt.services",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Usamos Face ID para confirmar tus operaciones."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear códigos QR de clientes y para fotografiar los documentos de tu verificación de agente.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para confirmar tus operaciones."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "La cámara se usa para fotografiar los documentos y el local de tu verificación de agente.",
          "photosPermission": "Puedes elegir de tu galería las fotos de los documentos de tu verificación de agente.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2A66",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0B5FFF"
        }
      ]
    ],
    "scheme": "velyntservices",
    "experiments": {
      "typedRoutes": false
    }
  }
}
