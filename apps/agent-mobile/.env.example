# Public configuration only: everything EXPO_PUBLIC_* is bundled into the app.
# The Velynt agents API (velynt/api-agente, port 8001). Android emulator -> host machine: http://10.0.2.2:8001
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
# Support contacts shown in "Ayuda y soporte" (hidden while empty), e.g. +240222000000
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_HOURS=
